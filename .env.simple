# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=Postgres_user
DB_PASSWORD=Postgres_password
DB_NAME=Postgres_db_name

# Django settings
DJANGO_SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=allowed_host1,allowed_host2
DEBUG=True or False